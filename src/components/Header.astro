---
import Arrow from './Arrow.astro';
const path = Astro.url.pathname;
const nav = [
  ['/', 'Showroom'],
  ['/katalog/', 'Koleksi'],
  ['/sports-mannequin/', 'Sports'],
  ['/kustom-finishing/', 'Finishing'],
  ['/artikel/', 'Artikel'],
  ['/kontak/', 'Kontak'],
];
---

<header class="site-header">
  <a href="/" class="wordmark" aria-label="Link Manekin, halaman utama">
    <img
      src="/images/link-manekin-logo.jpeg"
      alt=""
      class="brand-logo"
      width="38"
      height="38"
      loading="eager"
      decoding="async"
    />
    <span>
      LINK <span>MANEKIN</span>
    </span>
  </a>
  <nav class="desktop-nav" aria-label="Navigasi utama">
    {nav.map(([url, label]) => (
      <a href={url} aria-current={path === url || (url !== '/' && path.startsWith(url)) ? 'page' : undefined}>
        {label}
      </a>
    ))}
  </nav>
  <div class="header-actions">
    <button class="text-cta header-quote" data-quote-open>
      Mulai proyek <Arrow diagonal />
    </button>
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Buka menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Navigasi seluler" hidden>
    {nav.map(([url, label]) => (
      <a href={url} aria-current={path === url || (url !== '/' && path.startsWith(url)) ? 'page' : undefined}>
        {label}
      </a>
    ))}
    <button data-quote-open>Minta penawaran ↗</button>
  </nav>
</header>

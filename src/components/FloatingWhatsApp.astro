---
const phone = (
  import.meta.env.PUBLIC_WHATSAPP_NUMBER || '6281389896052'
).trim();
const message = encodeURIComponent(
  'Halo Link Manekin, saya ingin konsultasi kebutuhan manekin untuk bisnis saya.',
);
const href = phone ? `https://wa.me/${phone}?text=${message}` : 'https://wa.me/';
---

<a
  class="floating-whatsapp"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat Link Manekin melalui WhatsApp"
>
  <span class="floating-whatsapp-label">Konsultasi WhatsApp</span>
  <span class="floating-whatsapp-icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M27.4 4.6A15.7 15.7 0 0 0 2.7 23.5L.5 31.5l8.2-2.1A15.7 15.7 0 0 0 27.4 4.6Z" fill="currentColor"/>
      <path d="M23.7 18.9c-.4-.2-2.4-1.2-2.8-1.3-.4-.1-.7-.2-1 .2-.3.4-1.1 1.3-1.4 1.6-.3.3-.5.3-.9.1-2.4-1.2-4-2.2-5.7-5-.4-.7.4-.6 1.2-2.1.1-.3.1-.6 0-.8-.1-.2-1-2.3-1.3-3.2-.4-.9-.7-.8-1-.8h-.8c-.3 0-.8.1-1.2.6-.4.4-1.5 1.5-1.5 3.7s1.6 4.3 1.8 4.6c.2.3 3.1 4.8 7.6 6.7 2.8 1.2 3.9 1.3 5.3 1.1.9-.1 2.4-1 2.7-1.9.3-.9.3-1.7.2-1.9-.1-.2-.5-.3-.9-.5Z" fill="#fff"/>
    </svg>
  </span>
</a>

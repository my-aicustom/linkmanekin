---
const phone = (
  import.meta.env.PUBLIC_WHATSAPP_NUMBER || '6281389896052'
).trim();
const message = encodeURIComponent(
  'Halo Link Manekin, saya ingin konsultasi kebutuhan manekin untuk bisnis saya.',
);
const href = phone ? `https://wa.me/${phone}?text=${message}` : 'https://wa.me/';
---

<a
  class="floating-whatsapp"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat Link Manekin melalui WhatsApp"
>
  <span class="floating-whatsapp-label">Konsultasi WhatsApp</span>
  <span class="floating-whatsapp-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2.05 21.65a.75.75 0 0 0 .937.937l4.55-1.405A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2Zm-3.88 5.864c.245-.55.51-.561.75-.57.195-.008.414-.008.634-.008.22 0 .577.082.88.742.302.66 1.03 2.516 1.12 2.699.09.183.15.397.03.635-.12.238-.18.385-.357.593-.178.207-.374.464-.534.623-.179.177-.365.37-.157.727.208.356.924 1.524 1.982 2.466 1.36 1.213 2.507 1.588 2.863 1.766.357.177.564.148.774-.089.209-.238.892-1.04 1.13-1.396.238-.357.477-.297.803-.178.327.119 2.072.977 2.428 1.155.356.178.594.267.683.416.089.148.089.86-.208 1.692-.297.832-1.722 1.633-2.375 1.692-.625.056-1.442.083-4.147-.978-3.256-1.277-5.32-4.577-5.48-4.792-.16-.215-1.298-1.726-1.298-3.29 0-1.564.819-2.336 1.11-2.652Z" fill="#ffffff"/>
    </svg>
  </span>
</a>

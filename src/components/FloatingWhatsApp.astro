---
const phone = (
  import.meta.env.PUBLIC_WHATSAPP_NUMBER || '6281389896052'
).trim();
const message = encodeURIComponent(
  'Halo Link Manekin, saya ingin konsultasi kebutuhan manekin untuk bisnis saya.',
);
const href = phone ? `https://wa.me/${phone}?text=${message}` : 'https://wa.me/';
---

<a
  class="floating-whatsapp"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat Link Manekin melalui WhatsApp"
>
  <span class="floating-whatsapp-label">Konsultasi WhatsApp</span>
  <span class="floating-whatsapp-icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="30" height="30" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path fill="#fff" d="M16.02 3C8.85 3 3.02 8.77 3.02 15.88c0 2.27.6 4.49 1.75 6.44L3 29l6.87-1.79a13.1 13.1 0 0 0 6.15 1.52h.01c7.17 0 13-5.78 13-12.88a12.76 12.76 0 0 0-3.81-9.1A13.04 13.04 0 0 0 16.02 3Zm0 23.54h-.01c-1.9 0-3.77-.5-5.4-1.44l-.39-.23-4.08 1.06 1.09-3.96-.25-.4a10.67 10.67 0 0 1-1.63-5.69C5.35 9.99 10.13 5.3 16.02 5.3a10.8 10.8 0 0 1 7.67 3.15 10.5 10.5 0 0 1 3.13 7.4c0 5.9-4.84 10.7-10.8 10.7Zm5.92-8.01c-.32-.16-1.92-.94-2.22-1.05-.3-.1-.52-.16-.74.16-.22.32-.85 1.05-1.04 1.27-.19.21-.38.24-.7.08-.33-.16-1.37-.5-2.61-1.59a9.72 9.72 0 0 1-1.8-2.22c-.19-.32-.02-.49.14-.65.15-.14.33-.38.49-.57.16-.19.22-.32.33-.54.11-.21.05-.4-.03-.56-.08-.16-.74-1.76-1.01-2.41-.27-.63-.54-.55-.74-.56l-.63-.01c-.22 0-.57.08-.87.4-.3.32-1.14 1.1-1.14 2.68s1.17 3.1 1.33 3.31c.16.21 2.3 3.47 5.58 4.86.78.33 1.38.53 1.85.68.78.24 1.49.21 2.05.13.63-.1 1.92-.78 2.19-1.53.27-.75.27-1.4.19-1.53-.08-.13-.3-.21-.63-.37Z"/>
    </svg>
  </span>
</a>

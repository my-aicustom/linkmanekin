<dialog id="spec-dialog" class="spec-dialog" aria-labelledby="spec-title">
  <div class="dialog-top">
    <span class="eyebrow" id="spec-code"></span>
    <button class="close-button" data-close-dialog aria-label="Tutup detail">
      ×
    </button>
  </div>
  <img id="spec-image" width="650" height="800" alt="" />
  <div class="spec-content">
    <p class="eyebrow" id="spec-category"></p>
    <h2 id="spec-title"></h2>
    <p id="spec-description"></p>
    <div class="spec-material" id="spec-material"></div>
    <table>
      <caption>
        Dimensi referensi<span>(cm)</span>
      </caption>
      <tbody id="spec-measurements"></tbody>
    </table>
    <p class="small-copy">
      Ukuran final, pilihan base, dan stok dikonfirmasi saat penawaran. Visual
      adalah ilustrasi koleksi.
    </p>
    <button class="button button-dark" id="spec-quote">
      Tambahkan ke penawaran ↗
    </button>
  </div>
</dialog>

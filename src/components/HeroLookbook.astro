---
import Arrow from './Arrow.astro';
---

<section class="campaign-hero section-shell" aria-labelledby="hero-title">
  <div class="campaign-hero-heading">
    <div>
      <p class="eyebrow">LINK MANEKIN / PRODUCT COLLECTION</p>
      <h1 id="hero-title">
        Manekin untuk
        <em>menjual koleksi.</em>
      </h1>
    </div>

    <div class="campaign-hero-intro">
      <p>
        Pilih manekin berdasarkan kategori busana, proporsi, pose, material,
        dan finishing. Fokus kami: produk yang benar-benar bekerja di lantai retail.
      </p>
      <div class="campaign-hero-actions">
        <a href="/katalog/" class="button button-dark">
          Lihat katalog manekin <Arrow diagonal />
        </a>
        <a href="/kontak/" class="inline-link">Minta rekomendasi ↗</a>
      </div>
    </div>
  </div>

  <div class="campaign-hero-media campaign-product-stage" aria-label="Pilihan manekin Link Manekin">
    <a class="campaign-product-card" href="/manekin-wanita/">
      <div class="campaign-product-visual">
        <img
          src="/images/boutique-muse.svg"
          width="760"
          height="950"
          alt="CS-01 The Muse, manekin wanita untuk butik dan retail"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="campaign-product-meta">
        <span class="eyebrow">CS-01 / WOMEN'S RETAIL</span>
        <strong>The Muse</strong>
        <span>Warm Sand · Fiberglass Reinforced</span>
      </div>
    </a>

    <a class="campaign-product-card" href="/manekin-pria/">
      <div class="campaign-product-visual">
        <img
          src="/images/boutique-essential.svg"
          width="760"
          height="950"
          alt="CS-02 The Essential, manekin pria untuk menswear dan distro"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="campaign-product-meta">
        <span class="eyebrow">CS-02 / MEN'S RETAIL</span>
        <strong>The Essential</strong>
        <span>Matte Noir · Polyethylene</span>
      </div>
    </a>
  </div>

  <div class="campaign-product-footer" aria-label="Kategori utama">
    <span>MANEKIN WANITA</span>
    <span>MANEKIN PRIA</span>
    <span>SPORTS MANNEQUIN</span>
    <span>DRESSMAKER</span>
  </div>
</section>

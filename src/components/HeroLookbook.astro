---
import Arrow from './Arrow.astro';
---

<section class="hero section-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="tiny-line"></span> SCULPTURAL DISPLAY / INDONESIA
    </p>
    <h1 id="hero-title">
      Bentuk yang
      <br />
      <em>mengangkat koleksi.</em>
    </h1>
    <p class="hero-description">
      Manekin untuk retail, activewear, dan atelier—dipilih lewat pose,
      proporsi, material, dan finishing yang selaras dengan produk Anda.
    </p>
    <div class="hero-actions">
      <a href="/katalog/" class="button button-dark">
        Jelajahi koleksi <Arrow diagonal />
      </a>
      <a href="#lookbook" class="quiet-link">
        Lihat lookbook <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="hero-footnote" aria-label="Fokus Link Manekin">
      <span>RETAIL / ACTIVEWEAR / ATELIER</span>
      <span>FORM / FIT / FINISH</span>
    </div>
  </div>
  <div class="hero-stage">
    <span class="vertical-label">A STUDY OF FORM — LINK MANEKIN</span>
    <img
      src="/images/showroom-hero.svg"
      width="850"
      height="1000"
      alt="Studi manekin atletik berpose sprint dan manekin sand pada podium studio"
      fetchpriority="high"
    />
    <div class="stage-caption">
      <span>
        <span class="eyebrow">SIGNATURE DISPLAY FORMS</span>
        <span>Built around garment, space, and brand.</span>
      </span>
      <a href="/katalog/" aria-label="Jelajahi koleksi manekin">
        <Arrow diagonal />
      </a>
    </div>
    <span class="stage-index" aria-hidden="true">
      01 <span>/ 03</span>
    </span>
  </div>
</section>
<div class="material-strip" aria-label="Pilihan koleksi">
  <span>ATHLETIC FORMS</span>
  <span class="strip-cross" aria-hidden="true">✳</span>
  <span>TAILORING ESSENTIALS</span>
  <span class="strip-cross" aria-hidden="true">✳</span>
  <span>BOUTIQUE DISPLAY</span>
  <span class="strip-cross" aria-hidden="true">✳</span>
  <span>CRAFTED FOR YOUR SPACE</span>
</div>

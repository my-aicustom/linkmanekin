---
import Arrow from './Arrow.astro';
---

<section class="hero section-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="tiny-line"></span> LINK MANEKIN INDONESIA
    </p>
    <h1 id="hero-title">
      The art of
      <br />
      <em>presence.</em>
    </h1>
    <p class="hero-description">
      Bukan sekadar display. Sebuah bentuk yang memberi karakter pada koleksi
      Anda.
    </p>
    <div class="hero-actions">
      <a href="/katalog/" class="button button-dark">
        Temukan koleksi <Arrow diagonal />
      </a>
      <a href="#lookbook" class="quiet-link">
        Lihat lookbook <span>↓</span>
      </a>
    </div>
    <div class="hero-footnote">
      <span>FOR RETAIL. FOR ATELIER. FOR YOU.</span>
      <span>EST. IN INDONESIA</span>
    </div>
  </div>
  <div class="hero-stage">
    <span class="vertical-label">A STUDY OF FORM — LINK MANEKIN</span>
    <img
      src="/images/showroom-hero.svg"
      width="850"
      height="1000"
      alt="Ilustrasi manekin atletik berpose sprint dan manekin sand pada podium studio"
      fetchpriority="high"
    />
    <div class="stage-caption">
      <span>
        <span class="eyebrow">THE FORM COLLECTION</span>
        <span>Made to make an impression.</span>
      </span>
      <a href="/katalog/" aria-label="Jelajahi Form Collection">
        <Arrow diagonal />
      </a>
    </div>
    <span class="stage-index">
      01 <span>/ 03</span>
    </span>
  </div>
</section>
<div class="material-strip" aria-label="Pilihan koleksi">
  <span>ATHLETIC FORMS</span>
  <span class="strip-cross">✳</span>
  <span>TAILORING ESSENTIALS</span>
  <span class="strip-cross">✳</span>
  <span>BOUTIQUE DISPLAY</span>
  <span class="strip-cross">✳</span>
  <span>CRAFTED FOR YOUR SPACE</span>
</div>

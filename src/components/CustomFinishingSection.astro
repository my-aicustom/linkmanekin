---
import Arrow from './Arrow.astro';
const { full = false } = Astro.props;
---

<section class="finishing-section" id="finishes">
  <div class="finishing-art">
    <div class="finish-sphere sphere-noir" aria-hidden="true"></div>
    <div class="finish-sphere sphere-sand" aria-hidden="true"></div>
    <div class="finish-sphere sphere-white" aria-hidden="true"></div>
    <span class="art-annotation">SURFACE STUDIES / 01—03</span>
  </div>
  <div class="finishing-copy">
    <p class="eyebrow">04 / MATERIAL & FINISH</p>
    <h2>
      Satu bentuk.
      <br />
      <em>Banyak karakter.</em>
    </h2>
    <p>
      Finishing bukan kosmetik terakhir. Permukaan, base, dan detail menentukan
      bagaimana bentuk berinteraksi dengan cahaya, busana, dan ruang.
    </p>
    <div class="finish-swatches">
      <span>
        <i class="swatch noir"></i>Matte Noir
      </span>
      <span>
        <i class="swatch white"></i>Gloss White
      </span>
      <span>
        <i class="swatch linen"></i>Raw Linen
      </span>
      <span>
        <i class="swatch gold"></i>Brushed Gold
      </span>
    </div>
    {full ? (
      <button class="button button-light" data-quote-open>
        Diskusikan finishing <Arrow diagonal />
      </button>
    ) : (
      <a class="button button-light" href="/kustom-finishing/">
        Eksplorasi finishing <Arrow diagonal />
      </a>
    )}
  </div>
</section>

---
import Arrow from './Arrow.astro';
const { full = false } = Astro.props;
---

<section class="finishing-section" id="finishes">
  <div class="finishing-art">
    <div class="finish-sphere sphere-noir"></div>
    <div class="finish-sphere sphere-sand"></div>
    <div class="finish-sphere sphere-white"></div>
    <span class="art-annotation">SURFACE STUDIES / 01—03</span>
  </div>
  <div class="finishing-copy">
    <p class="eyebrow">03 / YOUR SIGNATURE FINISH</p>
    <h2>
      Bentuknya kami.
      <br />
      <em>Karakternya Anda.</em>
    </h2>
    <p>
      Matte yang tenang. Gloss yang tegas. Linen yang tak lekang. Selaraskan
      permukaan, base, dan detail dengan identitas ruang Anda.
    </p>
    <div class="finish-swatches">
      <span>
        <i class="swatch noir"></i>Matte Noir
      </span>
      <span>
        <i class="swatch white"></i>Gloss White
      </span>
      <span>
        <i class="swatch linen"></i>Raw Linen
      </span>
      <span>
        <i class="swatch gold"></i>Brushed Gold
      </span>
    </div>
    {full ? (
      <button class="button button-light" data-quote-open>
        Diskusikan finishing <Arrow diagonal />
      </button>
    ) : (
      <a class="button button-light" href="/kustom-finishing/">
        Eksplorasi finishing <Arrow diagonal />
      </a>
    )}
  </div>
</section>

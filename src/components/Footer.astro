---
import Arrow from './Arrow.astro';
---

<footer class="site-footer">
  <div class="footer-top">
    <div>
      <p class="eyebrow">YOUR NEXT COLLECTION STARTS HERE</p>
      <h2>
        Beri ruang untuk
        <br />
        <em>kesan pertama.</em>
      </h2>
    </div>
    <button
      class="round-cta"
      data-quote-open
      aria-label="Mulai permintaan penawaran"
    >
      <Arrow diagonal />
    </button>
  </div>
  <div class="footer-grid">
    <a href="/" class="footer-brand">
      LINK
      <br />
      MANEKIN<span>Forms for a lasting impression.</span>
    </a>
    <div>
      <p class="eyebrow">THE STUDIO</p>
      <p>
        Tangerang, Indonesia
        <br />
        Kunjungan dengan janji temu.
      </p>
      <button class="inline-link" data-quote-open>
        Hubungi studio ↗
      </button>
    </div>
    <div>
      <p class="eyebrow">EXPLORE</p>
      <a href="/katalog/">Seluruh koleksi</a>
      <a href="/sports-mannequin/">Sports mannequin</a>
      <a href="/kustom-finishing/">Custom finishing</a>
    </div>
    <div>
      <p class="eyebrow">FOR YOUR BUSINESS</p>
      <p>Retail · Atelier · Visual merchandising</p>
      <p class="small-copy">
        Harga, stok, minimum order, dan waktu produksi dikonfirmasi dalam
        penawaran.
      </p>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Link Manekin Indonesia</span>
    <span>Designed around your collection.</span>
    <a href="#top">Kembali ke atas ↑</a>
  </div>
</footer>

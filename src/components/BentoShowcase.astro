---
import Arrow from './Arrow.astro';
---

<section id="lookbook" class="section-shell collection-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">01 / CURATED COLLECTIONS</p>
      <h2>
        Tiga kebutuhan.
        <br />
        <em>Tiga bahasa bentuk.</em>
      </h2>
    </div>
    <p>
      Activewear membutuhkan energi; tailoring menuntut proporsi; retail perlu
      karakter yang memberi ruang bagi produk untuk tampil.
    </p>
  </div>
  <div class="lookbook-grid">
    <a class="lookbook-panel athletic-panel" href="/sports-mannequin/">
      <span class="panel-number">I.</span>
      <img
        src="/images/sports-sprint.svg"
        width="650"
        height="800"
        loading="lazy"
        alt="Studi manekin atletik dengan pose berlari"
      />
      <div class="panel-caption">
        <span>
          <span class="eyebrow">MOTION / TENSION / BALANCE</span>
          <h3>Athletic forms</h3>
          <span>Sports & activewear</span>
        </span>
        <Arrow diagonal />
      </div>
    </a>
    <a
      class="lookbook-panel atelier-panel"
      href="/katalog/?kategori=Dressmaker"
    >
      <span class="panel-number">II.</span>
      <img
        src="/images/dressmaker-couture.svg"
        width="650"
        height="800"
        loading="lazy"
        alt="Studi torso dressmaker berlapis linen"
      />
      <div class="panel-caption">
        <span>
          <span class="eyebrow">PROPORTION / DRAPE / FIT</span>
          <h3>The atelier</h3>
          <span>Dressmaker & tailoring</span>
        </span>
        <Arrow diagonal />
      </div>
    </a>
    <a class="lookbook-panel boutique-panel" href="/katalog/?kategori=Casual">
      <span class="panel-number">III.</span>
      <img
        src="/images/boutique-muse.svg"
        width="650"
        height="800"
        loading="lazy"
        alt="Studi manekin butik berwarna warm sand"
      />
      <div class="panel-caption">
        <span>
          <span class="eyebrow">PRESENCE / VERSATILITY</span>
          <h3>Retail muse</h3>
          <span>Boutique & visual display</span>
        </span>
        <Arrow diagonal />
      </div>
    </a>
  </div>
</section>

---
import Arrow from './Arrow.astro';
---

<section id="lookbook" class="section-shell collection-section collection-editorial" aria-labelledby="collection-title">
  <div class="collection-editorial-heading">
    <p class="eyebrow">01 / SHOP BY USE CASE</p>
    <h2 id="collection-title">
      Produk yang berbeda.
      <em>Fungsi yang jelas.</em>
    </h2>
    <p>
      Bukan moodboard generik. Setiap kategori di bawah langsung menunjukkan
      tipe manekin yang bisa dipilih untuk kebutuhan retail Anda.
    </p>
  </div>

  <div class="collection-ledger">
    <a class="collection-story collection-story-lead" href="/sports-mannequin/">
      <div class="collection-story-media product-led-media">
        <img
          src="/images/photos/mannequin-sprinter.webp"
          width="760"
          height="950"
          loading="lazy"
          decoding="async"
          alt="SP-01 The Sprinter, manekin sports pose lari untuk activewear"
        />
      </div>
      <div class="collection-story-copy">
        <span class="collection-story-index">01</span>
        <span class="eyebrow">SP-01 / SPORTS</span>
        <h3>The Sprinter</h3>
        <p>Pose lari untuk menampilkan gerak, siluet, dan potongan activewear.</p>
        <span class="product-spec">Fiberglass Reinforced · Matte Noir</span>
        <span class="collection-story-link">Lihat sports mannequin <Arrow diagonal /></span>
      </div>
    </a>

    <div class="collection-story-pair">
      <a class="collection-story" href="/manekin-jahit/">
        <div class="collection-story-media product-led-media">
          <img
            src="/images/dressmaker-couture.svg"
            width="760"
            height="950"
            loading="lazy"
            decoding="async"
            alt="DR-01 The Atelier, dressmaker mannequin untuk draping dan fitting"
          />
        </div>
        <div class="collection-story-copy">
          <span class="collection-story-index">02</span>
          <span class="eyebrow">DR-01 / DRESSMAKER</span>
          <h3>The Atelier</h3>
          <p>Torso untuk membaca jatuh kain, proporsi, draping, dan presentasi busana.</p>
          <span class="product-spec">Pinstickable Foam · Raw Linen</span>
          <span class="collection-story-link">Lihat manekin jahit <Arrow diagonal /></span>
        </div>
      </a>

      <a class="collection-story" href="/manekin-wanita/">
        <div class="collection-story-media product-led-media">
          <img
            src="/images/photos/mannequin-muse.webp"
            width="760"
            height="950"
            loading="lazy"
            decoding="async"
            alt="CS-01 The Muse, manekin wanita untuk butik dan display retail"
          />
        </div>
        <div class="collection-story-copy">
          <span class="collection-story-index">03</span>
          <span class="eyebrow">CS-01 / WOMEN'S RETAIL</span>
          <h3>The Muse</h3>
          <p>Postur tenang untuk butik, womenswear, layering, dan window display.</p>
          <span class="product-spec">Fiberglass Reinforced · Warm Sand</span>
          <span class="collection-story-link">Lihat manekin wanita <Arrow diagonal /></span>
        </div>
      </a>
    </div>
  </div>
</section>

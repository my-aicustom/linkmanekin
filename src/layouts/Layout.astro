---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpecDrawer from '../components/SpecDrawer.astro';
import WhatsAppQuoteModal from '../components/WhatsAppQuoteModal.astro';
import '../styles/global.css';
import '../styles/polish.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL('/', Astro.site);
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Link Manekin Indonesia',
      url: siteUrl,
      logo: new URL('/images/link-manekin-logo.jpeg', Astro.site),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Link Manekin Indonesia',
      inLanguage: 'id-ID',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: `${title} | Link Manekin Indonesia`,
      description,
      inLanguage: 'id-ID',
      isPartOf: { '@id': `${siteUrl}#website` },
    },
  ],
});
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf8f5" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Link Manekin Indonesia</title>
    <link rel="icon" type="image/jpeg" href="/images/link-manekin-logo.jpeg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Link Manekin Indonesia" />
    <meta property="og:title" content={`${title} | Link Manekin Indonesia`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL('/images/link-manekin-logo.jpeg', Astro.site)}
    />
    <meta
      property="og:image:alt"
      content="Logo Resmi Link Manekin Indonesia"
    />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={schema} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SpecDrawer />
    <WhatsAppQuoteModal />
    <script>
      import '../scripts/showroom';
      import '../scripts/motion';
    </script>
  </body>
</html>

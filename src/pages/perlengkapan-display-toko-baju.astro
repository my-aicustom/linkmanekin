---
import Layout from '../layouts/Layout.astro';
import '../styles/display-solutions.css';

const phone = '6281389896052';
const waBase = `https://wa.me/${phone}`;
const waLink = (message: string) => `${waBase}?text=${encodeURIComponent(message)}`;

const faq = [
  {
    q: 'Apa saja isi Paket Buka Toko Baju Lengkap?',
    a: 'Isinya disusun dari ukuran ruang dan cara Anda berjualan. Umumnya mencakup manekin full body atau torso, gawangan, hanger kayu, hanger jepit celana, lalu opsi custom rack dan finishing. Jumlah final sebaiknya ditentukan setelah melihat foto dan ukuran area.',
  },
  {
    q: 'Untuk bazaar, lebih cocok gawangan biasa atau Gawangan Baju Knock-Down Bazar?',
    a: 'Kalau sering pindah venue, model knock-down biasanya lebih masuk akal. Yang perlu dicek bukan cuma tampilannya, tetapi ukuran setelah dibongkar, berat, jenis sambungan, kapasitas gantung, dan berapa lama setup-nya.',
  },
  {
    q: 'Apa bedanya hanger kayu biasa dengan Hanger Jepit Celana Butik?',
    a: 'Hanger kayu cocok untuk atasan, dress dan outer. Untuk rok dan celana, hanger jepit lebih praktis karena posisi jepit bisa mengikuti lebar pakaian. Perhatikan juga pelindung jepit agar bahan tidak mudah berbekas.',
  },
  {
    q: 'Bisa konsultasi layout sebelum memilih manekin dan gawangan?',
    a: 'Bisa. Kirim ukuran area, foto ruang, jenis produk, perkiraan jumlah pakaian yang ingin dipajang, dan kisaran budget. Dari data sederhana itu pembahasan display sudah bisa jauh lebih konkret.',
  },
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
});
---

<Layout
  title="Perlengkapan Display Toko Baju — Manekin, Gawangan & Hanger Butik"
  description="Paket Perlengkapan Display Toko Baju untuk butik, distro, streetwear dan bazaar: Manekin Display Pakaian, Gawangan Baju Distro Minimalis, Gantungan Baju Butik Kayu dan hanger jepit celana."
>
  <article class="display-solutions">
    <section class="ds-hero ds-shell" aria-labelledby="display-hero-title">
      <div class="ds-hero-copy">
        <h1 id="display-hero-title">
          Buka toko jangan mulai dari
          <em>beli barang satu-satu.</em>
        </h1>
        <div class="ds-actions">
          <a
            class="ds-action ds-action-dark"
            href={waLink('Halo Link Manekin, saya mau konsultasi paket perlengkapan display untuk toko/butik saya. Saya bisa kirim foto dan ukuran ruang.')}
            target="_blank"
            rel="noopener noreferrer"
          >
            Konsultasi layout via WhatsApp ↗
          </a>
          <a class="ds-text-link" href="#paket-display">Lihat paket display ↓</a>
        </div>
      </div>

      <figure class="ds-hero-visual">
        <img
          src="/images/lookbook/modern-boutique-mannequin-display-4.png"
          width="1000"
          height="1200"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          alt="Manekin display pakaian di butik fashion modern"
        />
        <figcaption>
          <span>LINK MANEKIN / DISPLAY SYSTEM</span>
          <span>Retail · Boutique · Pop-up</span>
        </figcaption>
      </figure>
    </section>

    <section class="ds-statement" aria-label="Sistem display toko">
      <div class="ds-shell ds-statement-inner">
        <div>
          <p>Manekin. Gawangan. Hanger. Satu sistem display.</p>
          <span>
            Perlengkapan Display Toko Baju seharusnya dibaca sebagai satu komposisi, bukan daftar belanja.
            Manekin Display Pakaian menarik mata, Gawangan Baju Distro Minimalis mengatur ritme ruang,
            dan Gantungan Baju Butik Kayu menjaga koleksi tetap konsisten.
          </span>
        </div>
        <small>Untuk butik, distro, streetwear, bazaar, pop-up dan brand yang sedang menyiapkan toko pertamanya.</small>
      </div>
    </section>

    <section class="ds-services ds-shell" aria-labelledby="services-title">
      <header class="ds-section-intro">
        <span class="ds-kicker">01 / THE DISPLAY SYSTEM</span>
        <h2 id="services-title">Tiga barang yang harus terasa seperti satu keputusan.</h2>
        <p>
          Mulai dari pakaian, ruang, dan cara customer bergerak. Setelah itu baru tentukan bentuk manekin,
          konstruksi gawangan, hanger, serta finishing yang paling masuk akal.
        </p>
      </header>

      <article class="ds-service-row">
        <div class="ds-service-index">01</div>
        <div class="ds-service-copy">
          <span class="ds-service-label">MANNEQUIN</span>
          <h3>Manekin Display Pakaian</h3>
          <p>
            Jangan pilih manekin cuma karena bentuknya bagus di foto. Lihat jenis pakaian yang paling sering dijual,
            ukuran, pose, dan seberapa banyak ruang yang bisa diberikan ke satu look.
          </p>
          <div class="ds-spec-line"><span>Full body</span><span>Headless</span><span>Torso</span><span>Articulated</span></div>
        </div>
        <figure class="ds-service-media">
          <img
            src="/images/lookbook/streetwear-mannequin-modern-boutique.png"
            width="1000"
            height="1300"
            loading="lazy"
            decoding="async"
            alt="Manekin streetwear untuk display butik modern"
          />
        </figure>
      </article>

      <article class="ds-service-row reverse">
        <div class="ds-service-index">02</div>
        <div class="ds-service-copy">
          <span class="ds-service-label">GARMENT RACK</span>
          <h3>Gawangan Baju Distro Minimalis</h3>
          <p>
            Untuk toko tetap, bentuk boleh lebih permanen. Untuk bazaar, pikirkan mobil, lift venue, waktu bongkar-pasang,
            dan ukuran ketika disimpan. Di situ <strong>Gawangan Baju Knock-Down Bazar</strong> biasanya lebih masuk akal.
          </p>
          <div class="ds-spec-line"><span>Black matte</span><span>Industrial pipe</span><span>Stainless</span><span>Knock-down</span></div>
        </div>
        <figure class="ds-service-media">
          <img
            src="/images/lookbook/urban-techwear-mannequin-display.png"
            width="1000"
            height="1200"
            loading="lazy"
            decoding="async"
            alt="Konsep display distro dan streetwear dengan gawangan minimalis"
          />
        </figure>
      </article>

      <article class="ds-service-row">
        <div class="ds-service-index">03</div>
        <div class="ds-service-copy">
          <span class="ds-service-label">HANGER</span>
          <h3>Gantungan Baju Butik Kayu</h3>
          <p>
            Hanger adalah detail yang dilihat ratusan kali dalam satu rak. Pilih finishing yang selaras dengan toko,
            lalu gunakan <strong>Hanger Jepit Celana Butik</strong> untuk rok dan celana supaya display tetap rapi.
          </p>
          <div class="ds-spec-line"><span>Natural</span><span>Dark oak</span><span>Luxury white</span><span>Clip hanger</span></div>
        </div>
        <figure class="ds-service-media">
          <img
            src="/images/lookbook/modern-boutique-mannequin-display-3.png"
            width="1000"
            height="1200"
            loading="lazy"
            decoding="async"
            alt="Display butik dengan hanger kayu dan manekin modern"
          />
        </figure>
      </article>
    </section>

    <section class="ds-lookbook" aria-labelledby="lookbook-title">
      <div class="ds-shell">
        <header class="ds-section-intro light">
          <span class="ds-kicker">02 / FROM MOOD TO MERCHANDISING</span>
          <h2 id="lookbook-title">Sebelum beli barangnya, lihat dulu suasana yang ingin dibangun.</h2>
          <p>
            Referensi ini bukan template toko. Fungsinya supaya Anda dan tim punya bahasa visual yang sama saat membahas
            streetwear, butik modern, warm atelier, atau display yang lebih premium.
          </p>
        </header>

        <div class="ds-editorial-pair" tabindex="0" role="region" aria-label="Koleksi lookbook display retail">
          <figure class="ds-editorial-panel tall">
            <img
              src="/images/lookbook/mannequin-lookbook-warm-retail-collage.png"
              width="1400"
              height="1000"
              loading="lazy"
              decoding="async"
              alt="Lookbook warm retail untuk butik fashion dan atelier"
            />
            <figcaption><span>WARM / ATELIER</span><strong>Ruang yang lebih tenang membuat detail pakaian ikut bekerja.</strong></figcaption>
          </figure>
          <figure class="ds-editorial-panel offset">
            <img
              src="/images/lookbook/premium-mannequin-showroom-moodboard.png"
              width="1600"
              height="1200"
              loading="lazy"
              decoding="async"
              alt="Moodboard showroom premium untuk sistem display fashion retail"
            />
            <figcaption><span>SHOWROOM / PREMIUM</span><strong>Kurangi objek. Naikkan kejelasan antara hero product dan pendukungnya.</strong></figcaption>
          </figure>
        </div>

        <figure class="ds-editorial-wide">
          <img
            src="/images/lookbook/mannequin-showroom-lookbook-collage.png"
            width="1600"
            height="1000"
            loading="lazy"
            decoding="async"
            alt="Lookbook lengkap manekin, showroom dan perlengkapan display toko"
          />
          <figcaption>
            <span>LOOKBOOK / DISPLAY SYSTEM</span>
            <strong>Bukan cuma manekin. Cara semuanya ditempatkan menentukan apakah toko terasa rapi atau sekadar penuh.</strong>
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="paket-display" class="ds-packages ds-shell" aria-labelledby="package-title">
      <header class="ds-section-intro">
        <span class="ds-kicker">03 / PAKET BUKA TOKO BAJU LENGKAP</span>
        <h2 id="package-title">Mulai dari skala toko. Bukan dari paket paling mahal.</h2>
        <p>
          Tiga konfigurasi ini hanya titik awal. Jumlah unit, ukuran, material, finishing, dan detail konstruksi tetap
          dikonfirmasi setelah ruang dan kebutuhan Anda terlihat jelas.
        </p>
      </header>

      <div class="ds-package-table">
        <article class="ds-package-row">
          <div class="ds-package-index">01</div>
          <div class="ds-package-name"><span>BAZAAR & POP-UP</span><h3>Paket Starter</h3></div>
          <div class="ds-package-copy">Untuk tenant yang perlu setup cepat, ringkas saat dibawa, dan cukup fleksibel untuk pindah venue.</div>
          <ul>
            <li>1 gawangan knock-down</li>
            <li>50 hanger kayu butik</li>
            <li>1 torso manekin</li>
          </ul>
          <a href={waLink('Halo Link Manekin, saya tertarik Paket Starter untuk bazaar / pop-up. Bisa dibantu estimasi dan ukurannya?')} target="_blank" rel="noopener noreferrer">Bahas Starter ↗</a>
        </article>

        <article class="ds-package-row featured">
          <div class="ds-package-index">02</div>
          <div class="ds-package-name"><span>BOUTIQUE / DAILY RETAIL</span><h3>Paket Boutique Pro</h3></div>
          <div class="ds-package-copy">Untuk butik atau distro dengan ruang tetap yang ingin window, mannequin, rack dan hanger terasa konsisten.</div>
          <ul>
            <li>2 manekin full body</li>
            <li>2 gawangan industrial / minimalis</li>
            <li>150 hanger + hanger jepit</li>
          </ul>
          <a href={waLink('Halo Link Manekin, saya mau konsultasi Paket Boutique Pro untuk toko saya. Saya bisa kirim ukuran ruang dan foto lokasi.')} target="_blank" rel="noopener noreferrer">Konsultasi Pro ↗</a>
        </article>

        <article class="ds-package-row">
          <div class="ds-package-index">03</div>
          <div class="ds-package-name"><span>CUSTOM / BRAND LED</span><h3>Paket Flagship Store</h3></div>
          <div class="ds-package-copy">Untuk brand yang ingin sistem display lebih khas dan mulai memperlakukan interior sebagai bagian dari identitas.</div>
          <ul>
            <li>Custom rack layout</li>
            <li>Premium headless mannequin</li>
            <li>Opsi hanger laser-logo</li>
          </ul>
          <a href={waLink('Halo Link Manekin, saya ingin bahas Paket Flagship Store dan custom rack layout. Bisa konsultasi dari layout/foto toko?')} target="_blank" rel="noopener noreferrer">Bahas custom ↗</a>
        </article>
      </div>
    </section>

    <section class="ds-before-buy" aria-labelledby="practical-title">
      <div class="ds-shell ds-before-grid">
        <div class="ds-before-heading">
          <span class="ds-kicker">04 / BEFORE YOU BUY</span>
          <h2 id="practical-title">Empat hal yang biasanya baru terasa setelah barang datang.</h2>
          <p>Lebih baik dibahas sekarang daripada jadi pekerjaan tambahan saat toko mau opening.</p>
        </div>
        <div class="ds-question-list">
          <article class="ds-question">
            <span>01</span>
            <div><h3>Kalau sering ikut bazaar, jangan pilih gawangan yang makan tempat di mobil.</h3><p>Ukuran saat dibongkar, berat, sambungan, dan waktu setup bisa lebih penting daripada desainnya.</p></div>
          </article>
          <article class="ds-question">
            <span>02</span>
            <div><h3>Manekin harus mengikuti pakaian yang benar-benar Anda jual.</h3><p>Sportswear, tailoring, dress, modest fashion, dan streetwear membutuhkan pose dan proporsi yang berbeda.</p></div>
          </article>
          <article class="ds-question">
            <span>03</span>
            <div><h3>Rak penuh bukan berarti display-nya bagus.</h3><p>Hitung berapa pakaian yang memang perlu terlihat. Sisanya lebih baik tetap menjadi stok daripada membuat customer sulit melihat produk.</p></div>
          </article>
          <article class="ds-question">
            <span>04</span>
            <div><h3>Hanger murah jadi mahal kalau pakaian sering jatuh atau berbekas.</h3><p>Untuk rok dan celana, lihat kekuatan jepit, pelindung clip, dan lebar hanger—bukan warna saja.</p></div>
          </article>
        </div>
      </div>
    </section>

    <section class="ds-material-story ds-shell" aria-labelledby="material-title">
      <div class="ds-material-copy">
        <span class="ds-kicker">05 / MATERIAL, FIT & DURABILITY</span>
        <h2 id="material-title">Bagus difoto saja tidak cukup.</h2>
        <p>
          Untuk proyek custom, material dan ukuran dibahas sebelum produksi. Tujuannya bukan membuat spesifikasi terdengar rumit,
          tapi memastikan barang tetap masuk akal ketika dipakai setiap hari.
        </p>
        <dl class="ds-material-list">
          <div><dt>Kayu</dt><dd>Finishing natural, dark oak atau white; treatment dan jenis kayu dikonfirmasi sesuai proyek.</dd></div>
          <div><dt>Besi</dt><dd>Panjang bentang, beban gantung, konstruksi dan finishing perlu disesuaikan fungsi rack.</dd></div>
          <div><dt>Sambungan</dt><dd>Untuk knock-down, kemudahan rakit harus tetap bertemu dengan presisi saat berdiri.</dd></div>
          <div><dt>Ukuran</dt><dd>Manekin, hanger dan gawangan harus mengikuti pakaian, ruang, serta jalur customer.</dd></div>
        </dl>
      </div>

      <figure class="ds-material-media">
        <img
          src="/images/lookbook/modern-mannequin-retail-moodboard.png"
          width="1400"
          height="1100"
          loading="lazy"
          decoding="async"
          alt="Detail material dan sistem display manekin untuk retail modern"
        />
        <figcaption><span>MATERIAL STUDY</span><strong>Finish, joint, base, proportion.</strong></figcaption>
      </figure>
    </section>

    <section class="ds-usecase" aria-labelledby="usecase-title">
      <div class="ds-shell">
        <header class="ds-section-intro light">
          <span class="ds-kicker">06 / BUILT AROUND THE STORE</span>
          <h2 id="usecase-title">Toko butik dan tenant bazaar tidak perlu dipaksa punya sistem yang sama.</h2>
        </header>
        <div class="ds-usecase-notes">
          <article><span>01</span><div><strong>Butik wanita</strong><p>Dress, outer, modest wear, occasionwear dan tailoring ringan membutuhkan ruang napas dan pengelompokan look yang jelas.</p></div></article>
          <article><span>02</span><div><strong>Distro & streetwear</strong><p>Graphic tee, denim, cargo, sneakers dan layered styling lebih kuat jika rack-nya tegas dan mudah dibaca dari jarak jauh.</p></div></article>
          <article><span>03</span><div><strong>Bazaar & pop-up</strong><p>Portable, cepat setup, mudah disimpan dan tidak menyulitkan saat pindah venue. Mobil dan akses venue ikut menentukan desain.</p></div></article>
          <article><span>04</span><div><strong>Brand growing</strong><p>Mulai dari konfigurasi yang cukup. Custom lebih jauh ketika pola jualan, SKU, dan kebutuhan visual merchandising sudah terbaca.</p></div></article>
        </div>
      </div>
    </section>

    <section class="ds-faq ds-shell" aria-labelledby="faq-title">
      <header class="ds-section-intro compact">
        <span class="ds-kicker">07 / BEFORE WE QUOTE</span>
        <h2 id="faq-title">Pertanyaan yang biasanya muncul sebelum pesan.</h2>
      </header>
      <div class="ds-faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="ds-final">
      <div class="ds-shell ds-final-grid">
        <div>
          <span class="ds-kicker">08 / START WITH YOUR SPACE</span>
          <h2>Kirim ukuran toko. Mulai dari yang benar-benar perlu.</h2>
          <p>
            Tidak harus langsung ambil paket terbesar. Kirim foto ruang, ukuran area, jenis pakaian,
            dan kisaran budget. Dari situ percakapannya bisa langsung konkret.
          </p>
        </div>
        <a
          class="ds-action"
          href={waLink('Halo Link Manekin, saya mau konsultasi Perlengkapan Display Toko Baju. Saya siap kirim foto dan ukuran ruang.')}
          target="_blank"
          rel="noopener noreferrer"
        >Mulai konsultasi WhatsApp ↗</a>
      </div>
    </section>

    <script type="application/ld+json" set:html={faqSchema} />
  </article>
</Layout>

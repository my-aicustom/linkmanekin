---
import Layout from '../layouts/Layout.astro';
import MannequinCatalog from '../components/MannequinCatalog.astro';
---

<Layout
  title="Katalog Manekin & Display B2B"
  description="Jelajahi manekin sports, casual, dressmaker, hangers, dan racks. Bandingkan ukuran referensi, material, kategori, lalu susun penawaran multi-item melalui WhatsApp."
>
  <section class="section-shell page-intro">
    <p class="eyebrow">THE FORM INDEX / LINK MANEKIN</p>
    <h1>
      Bandingkan bentuk.
      <br />
      <em>Putuskan dengan yakin.</em>
    </h1>
    <div class="intro-bottom">
      <p>
        Filter kategori, buka tabel ukuran, lalu susun kebutuhan multi-item.
        Katalog ini dibuat untuk mempercepat keputusan B2B, bukan sekadar
        menjadi galeri produk.
      </p>
      <button class="button button-dark" data-quote-open>
        Susun penawaran ↗
      </button>
    </div>
  </section>
  <MannequinCatalog heading={false} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';
---

<Layout
  title="Artikel Manekin & Visual Merchandising"
  description="Panduan memilih manekin untuk retail, sportswear, atelier, dan custom finishing dari Link Manekin Indonesia."
>
  <section class="section-shell page-intro article-intro">
    <p class="eyebrow">THE DISPLAY JOURNAL / LINK MANEKIN</p>
    <h1>
      Pengetahuan untuk
      <br />
      <em>display yang lebih tepat.</em>
    </h1>
    <div class="intro-bottom">
      <p>
        Catatan praktis tentang proporsi, pose, material, finishing, dan visual
        merchandising untuk membantu keputusan sebelum membeli.
      </p>
      <a class="button button-dark" href="/kontak/">Diskusikan proyek ↗</a>
    </div>
  </section>

  <section class="section-shell article-index" aria-label="Daftar artikel">
    <div class="article-grid">
      {articles.map((article, index) => (
        <article class:list={['article-card', index === 0 && 'article-card-featured']}>
          <a class="article-card-image" href={`/artikel/${article.slug}/`} aria-label={`Baca ${article.title}`}>
            <img
              src={article.image}
              width="900"
              height="700"
              loading={index === 0 ? 'eager' : 'lazy'}
              alt=""
            />
          </a>
          <div class="article-card-body">
            <div class="article-card-meta">
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>
            <h2><a href={`/artikel/${article.slug}/`}>{article.title}</a></h2>
            <p>{article.excerpt}</p>
            <a class="inline-link" href={`/artikel/${article.slug}/`}>Baca artikel ↗</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

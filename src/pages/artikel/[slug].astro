---
import Layout from '../../layouts/Layout.astro';
import { articles, type Article } from '../../data/articles';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: Article };
const siteUrl = new URL('/', Astro.site);
const canonical = new URL(`/artikel/${article.slug}/`, Astro.site);
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: article.title,
  description: article.excerpt,
  image: [new URL(article.ogImage, Astro.site)],
  datePublished: article.datePublished,
  dateModified: article.dateModified,
  articleSection: article.category,
  inLanguage: 'id-ID',
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  author: {
    '@type': 'Organization',
    '@id': `${siteUrl}#organization`,
    name: 'Link Manekin Indonesia',
  },
  publisher: { '@id': `${siteUrl}#organization` },
});
---

<Layout
  title={article.title}
  description={article.excerpt}
  image={article.ogImage}
  imageAlt={article.imageAlt}
  ogType="article"
  publishedTime={article.datePublished}
  modifiedTime={article.dateModified}
  breadcrumbs={[
    { name: 'Beranda', href: '/' },
    { name: 'Artikel', href: '/artikel/' },
    { name: article.title, href: `/artikel/${article.slug}/` },
  ]}
>
  <article class="article-page">
    <header class="section-shell article-hero">
      <a class="article-back" href="/artikel/">← Semua artikel</a>
      <div class="article-kicker">
        <span>{article.category}</span>
        <time datetime={article.datePublished}>{article.date}</time>
        <span>{article.readingTime}</span>
      </div>
      <h1>{article.title}</h1>
      <p class="article-lead">{article.intro}</p>
    </header>

    <div class="article-cover">
      <img
        src={article.image}
        width="1600"
        height="900"
        alt={article.imageAlt}
        decoding="async"
      />
    </div>

    <div class="section-shell article-body-wrap">
      <div class="article-body">
        {article.sections.map((section, index) => (
          <section>
            <span class="article-section-number">{String(index + 1).padStart(2, '0')}</span>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul>
                {section.bullets.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>
        ))}
      </div>

      <aside class="article-aside">
        <p class="eyebrow">NEXT / FROM RESEARCH TO DISPLAY</p>
        <h2>Diskusikan display Anda.</h2>
        <p>
          Kirim jenis produk, kebutuhan ruang, dan jumlah unit. Kami bantu
          mempersempit pilihan sebelum penawaran.
        </p>
        {article.relatedLinks.map((link) => (
          <p><a class="inline-link" href={link.href}>{link.label} ↗</a></p>
        ))}
        <a class="button button-dark" href="/kontak/">Hubungi studio ↗</a>
      </aside>
    </div>
  </article>
  <script type="application/ld+json" set:html={articleSchema} />
</Layout>

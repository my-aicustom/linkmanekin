---
import Layout from '../layouts/Layout.astro';
import HeroLookbook from '../components/HeroLookbook.astro';
import BentoShowcase from '../components/BentoShowcase.astro';
import MannequinCatalog from '../components/MannequinCatalog.astro';
import CustomFinishingSection from '../components/CustomFinishingSection.astro';
import SocialShowcase from '../components/SocialShowcase.astro';
import { articles } from '../data/articles';
---

<Layout
  title="Jual Manekin Display untuk Retail, Butik & Atelier"
  description="Link Manekin Indonesia menyediakan manekin display untuk butik, retail, sportswear dan atelier, termasuk manekin wanita, pria, sports, dressmaker, hanger, rack, serta custom finishing."
>
  <HeroLookbook />
  <BentoShowcase />

  <section class="section-shell statement-section" aria-labelledby="statement-title">
    <p class="eyebrow">02 / FORM, FIT, FINISH</p>
    <div class="statement-grid">
      <h2 id="statement-title">
        Display yang baik bukan dekorasi.
        <em>Ia mengarahkan cara produk dilihat.</em>
      </h2>
      <div class="statement-notes">
        <p>
          Kami memulai dari tiga hal: bentuk yang sesuai kategori, proporsi yang
          masuk akal untuk busana, dan finishing yang menyatu dengan ruang.
        </p>
        <div class="statement-index" aria-label="Prinsip pemilihan display">
          <span><b>01</b> FORM</span>
          <span><b>02</b> FIT</span>
          <span><b>03</b> FINISH</span>
        </div>
        <p>
          <a class="inline-link" href="/manekin-wanita/">Manekin wanita ↗</a>
          {' · '}
          <a class="inline-link" href="/manekin-pria/">Manekin pria ↗</a>
          {' · '}
          <a class="inline-link" href="/manekin-jahit/">Manekin jahit ↗</a>
        </p>
        <a class="inline-link" href="/perlengkapan-display-toko-baju/">
          Lihat paket perlengkapan display toko baju ↗
        </a>
      </div>
    </div>
  </section>

  <MannequinCatalog limit={4} />
  <CustomFinishingSection />

  <section class="section-shell studio-section">
    <div>
      <p class="eyebrow">05 / FROM OUR STUDIO TO YOUR SPACE</p>
      <h2>
        Pilih lebih tepat.
        <br />
        <em>Pesan lebih jelas.</em>
      </h2>
    </div>
    <div class="studio-text">
      <p>
        Ceritakan jenis busana, kebutuhan ruang, jumlah unit, dan kota
        pengiriman. Kami bantu mempersempit pilihan bentuk sampai finishing
        sebelum penawaran disusun.
      </p>
      <div class="process-list">
        <div class="process-row">
          <span>01</span>
          <div>
            <h3>Pilih bentuk</h3>
            <p>Bandingkan pose, kategori, dan proporsi yang relevan.</p>
          </div>
        </div>
        <div class="process-row">
          <span>02</span>
          <div>
            <h3>Selaraskan finish</h3>
            <p>Tentukan material, warna, tekstur, dan karakter base.</p>
          </div>
        </div>
        <div class="process-row">
          <span>03</span>
          <div>
            <h3>Susun RFQ</h3>
            <p>Kirim kebutuhan multi-item dalam format WhatsApp yang rapi.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell article-index" aria-labelledby="journal-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">06 / THE DISPLAY JOURNAL</p>
        <h2 id="journal-title">
          Beli lebih paham.
          <br />
          <em>Display lebih matang.</em>
        </h2>
      </div>
      <a class="inline-link" href="/artikel/">Lihat semua artikel ↗</a>
    </div>
    <div class="article-grid">
      {articles.slice(0, 3).map((article) => (
        <article class="article-card">
          <a class="article-card-image" href={`/artikel/${article.slug}/`} aria-label={`Baca ${article.title}`}>
            <img
              src={article.image}
              width="900"
              height="700"
              loading="lazy"
              decoding="async"
              alt={article.imageAlt}
            />
          </a>
          <div class="article-card-body">
            <div class="article-card-meta">
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>
            <h2><a href={`/artikel/${article.slug}/`}>{article.title}</a></h2>
            <p>{article.excerpt}</p>
            <a class="inline-link" href={`/artikel/${article.slug}/`}>Baca artikel ↗</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <SocialShowcase />
</Layout>
